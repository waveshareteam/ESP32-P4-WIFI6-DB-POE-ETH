# Default text normalization and line endings.
* text=auto

# Source code and configuration files use LF.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.ino text eol=lf
*.S text eol=lf
*.s text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets are committed without text conversion.
*.bin binary
*.elf binary
*.map binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.bmp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.avi binary
