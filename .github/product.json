{
  "$schema": "https://raw.githubusercontent.com/waveshareteam/esp32-repo-template/v1/schema/product.schema.json",
  "product": "ESP32-P4-WIFI6-DB-POE-ETH",
  "product_url": "https://www.waveshare.net/shop/ESP32-P4-WIFI6-DB-POE-ETH.htm",
  "tier": 0,
  "target": "esp32p4",
  "esp_idf": {
    "versions": [
      "v5.5.6",
      "v6.1"
    ]
  },
  "factory_firmware": {
    "esp_idf": "v5.5.6"
  },
  "overrides": {
    "markdown_audit": {
      "classification_rules": [
        {
          "category": "first_party_customer",
          "patterns": [
            "examples/components/**",
            "examples/factory/components/Camera/config/**",
            "examples/esp-idf/17_hw_console/components/**"
          ]
        }
      ]
    }
  }
}
